// VSCode keybindings
[
    // Escape from VS Code integrated terminal back to editor
    {
        "key": "ctrl+x",
        "command": "workbench.action.terminal.focus",
        "when": "terminalFocus"
    },

    // Sidebar toggle (mac)
    {
        "key": "cmd+e",
        "command": "-editor.action.addSelectionToNextFindMatch"
    },
    {
        "key": "cmd+e",
        "command": "workbench.action.toggleSidebarVisibility"
    },
    // Sidebar toggle (linux)
    {
        "key": "alt+e",
        "command": "workbench.action.toggleSidebarVisibility"
    },

    // Claude sidebar (mac)
    {
        "key": "cmd+b",
        "command": "-workbench.action.toggleSidebarVisibility"
    },
    {
        "key": "cmd+b",
        "command": "claude-vscode.sidebar.open",
        "when": "!auxiliaryBarVisible"
    },
    {
        "key": "cmd+b",
        "command": "workbench.action.toggleAuxiliaryBar",
        "when": "auxiliaryBarVisible"
    },
    // Claude sidebar (linux)
    {
        "key": "alt+b",
        "command": "claude-vscode.sidebar.open",
        "when": "!auxiliaryBarVisible"
    },
    {
        "key": "alt+b",
        "command": "workbench.action.toggleAuxiliaryBar",
        "when": "auxiliaryBarVisible"
    }
]
